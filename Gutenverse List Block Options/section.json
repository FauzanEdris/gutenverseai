[
	{
			"title": "Layouts",
			"panelArray": [
					{
							"id": "layout",
							"label": "Content Width",
							"component": "SelectControl",
							"options": [
									{
											"label": "Fullwidth Section",
											"value": "fullwidth"
									},
									{
											"label": "Normal Width Section",
											"value": "boxed"
									}
							],
							"style": [
									{
											"selector": "section.guten-section.0x0x0x0.layout-boxed > .guten-container",
											"updateID": "width-style-0"
